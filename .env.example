# ========================================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR YARBIS
# ========================================================
APP_NAME=Yarbis Voice Assistant Backend
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Base URL para servir enlaces de audio a clientes móviles (Kotlin / Android)
# Si pruebas en emulador Android usa http://10.0.2.2:8000
# Si pruebas en dispositivo físico usa la IP local de tu PC, ej. http://192.168.1.50:8000
SERVER_BASE_URL=http://localhost:8000

# ========================================================
# CONFIGURACIÓN DEL ASISTENTE Y WAKE WORD
# ========================================================
ASSISTANT_NAME=Yarbis
# REQUIRE_WAKE_WORD: Si es True, exige que la transcripción contenga "Yarbis" al inicio.
# Si es False, permite procesar comandos directos (ej. botón push-to-talk en Kotlin/Android).
REQUIRE_WAKE_WORD=False

# ========================================================
# CEREBRO / LLM (OpenAI / Compatible)
# ========================================================
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o-mini
# Opcional: Base URL para proveedores compatibles con OpenAI (Groq, vLLM, Ollama, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# ========================================================
# SERVICIOS DE AUDIO (STT / TTS)
# ========================================================
# STT_PROVIDER: "openai" o "mock" (para pruebas sin gastar créditos)
STT_PROVIDER=openai

# TTS_PROVIDER: "edge_tts" (gratuito, sin API key, voces neuronales de alta calidad),
#               "openai" (usando openai tts-1), o "mock"
TTS_PROVIDER=edge_tts

# Voz por defecto para Edge TTS:
# "es-ES-AlvaroNeural" (masculina profesional), "es-MX-JorgeNeural", "es-ES-ElviraNeural"
EDGE_TTS_VOICE=es-ES-AlvaroNeural

# Voz por defecto para OpenAI TTS: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=onyx
